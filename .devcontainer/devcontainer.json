
{
  "name": "PenTAG Resource Planner",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [3001, 5173, 5555],
  "portsAttributes": {
    "3001": { "label": "API Server",     "onAutoForward": "silent" },
    "5173": { "label": "App (Frontend)", "onAutoForward": "openBrowser" },
    "5555": { "label": "Prisma Studio",  "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm run setup && cd server && npx prisma db push && npx tsx prisma/seed.ts",
  "postStartCommand": "echo 'Ready! Run: npm run dev'",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "js/ts.preferences.importModuleSpecifier": "relative"
      }
    }
  }
}

